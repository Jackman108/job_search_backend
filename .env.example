# See docs/ENV-MATRIX.md (job_search) for required vs optional.
NODE_ENV=development
HOST=localhost
PROTOCOL=http
PROTOCOL_WS=ws

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=job_search
# ≥32 chars; production refuses known defaults (change_me / very_secret / your-secret-key)
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
# AES-256-GCM key for HH login passwords at rest (32 bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep an offline local backup (D2). Production refuses missing/zero key.
# Dev fallback if unset: zero key (warns at boot) — set a real key before storing real HH passwords.
# HH_CRED_KEY=

API_PORT=8000
WS_PORT=8080
DOMAIN_PORT=3000
API_URL=http://localhost:8000
WS_URL=ws://localhost:8080
# CORS origin for the SPA (same name as auth). Falls back to DOMAIN_URL then localhost:3000.
ALLOWED_ORIGIN=http://localhost:3000
# DOMAIN_URL=http://localhost:3000
# debug | info | warn | error — default: info (dev) / warn (production)
LOG_LEVEL=info
# E7 optional Seq sink (console always on). Start: docker compose --profile logs up -d seq
# SEQ_URL=http://localhost:5341
# JSON body size (default 1mb). Raise only if needed for large webhooks.
# JSON_BODY_LIMIT=1mb
# OpenAPI UI: off in production unless set true/1
# SWAGGER_ENABLED=1

# Headless Puppeteer by default. Headed only: HH_HEADED=1 or PUPPETEER_HEADLESS=false
# HH_HEADED=1
# PUPPETEER_HEADLESS=false
# HH_CAPTCHA_WAIT_MS=300000
# HH_CLEAR_SESSION=1
# HH_USER_DATA_DIR=
# HH_JOBS_DIR=
# HH_APPLY_CAP=
# HH_APPLY_PAUSE_MS=
# HH_MAX_FEEDBACK_CHATS=
# HH_TOTAL_PAGES=
# Detached @market-hunter/hh-worker (queue-only)
# HH_WORKER_ENTRY=
# HH_WORKER_DEPS_FACTORY=

# Optional crypto payments (NOWPayments) — omit locally; missing key only warns
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_URL_DEV=
# NOWPAYMENTS_URL_PROD=
# CRYPTO_DEFAULT_CURRENCY=
# CRYPTO_MIN_AMOUNT=
# CRYPTO_MAX_AMOUNT=
# CRYPTO_MAX_RETRIES=
# CRYPTO_RETRY_DELAY=
# CRYPTO_PAYMENT_TIMEOUT=

# Optional WebPay — omit locally
# WEBPAY_SECRET_KEY=
# WEBPAY_STORE_ID=
# WEBPAY_VERSION=2
# WEBPAY_URL_BASE_DEV=
# WEBPAY_URL_BASE_PROD=
# WEBPAY_DEFAULT_CURRENCY=BYN
# WEBPAY_PAYMENT_TIMEOUT=
# WEBPAY_MOCK_TIMEOUT=
# WEBPAY_NOTIFY_URL=

# Payment tuning / mocks
# PAYMENT_OPERATION_TIMEOUT=
# PAYMENT_MAX_RETRIES=
# PAYMENT_RETRY_DELAY=
# PAYMENT_LOGGING_ENABLED=
# PAYMENT_LOG_WEBHOOKS=
# PAYMENT_LOG_LEVEL=
# MOCK_PAYMENT_TIMEOUT=
# MOCK_PAYMENT_SUCCESS_RATE=
