DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=db_vacancy
# ≥32 chars; production refuses known defaults (change_me / very_secret / your-secret-key)
JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
API_PORT=8000
WS_PORT=8080
DOMAIN_PORT=3000
# debug | info | warn | error — default: info (dev) / warn (production)
LOG_LEVEL=info
# Optional crypto payments (NOWPayments) — omit locally; missing key only warns, no ERROR spam
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# Detached @market-hunter/hh-worker (queue-only)
# Optional absolute path to worker entry (defaults to packages/hh-worker/bin/run.mjs)
# HH_WORKER_ENTRY=
# Optional deps factory module (defaults to src/worker/createProcessJobDeps.ts)
# HH_WORKER_DEPS_FACTORY=
