{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM"],
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "rootDir": ".",
        "outDir": "./dist",
        "allowJs": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "ignoreDeprecations": "5.0",
        "baseUrl": ".",
        "paths": {
            "@config": ["src/config/index.ts"],
            "@server": ["src/server/index.ts"],
            "@routes": ["src/routes/index.ts"],
            "@middlewares": ["src/middlewares/index.ts"],
            "@integrations": ["src/modules/payments/providers/index.ts"],
            "@run": ["packages/hh-worker/src/run/index.ts"],
            "@market-hunter/contracts": ["packages/contracts/src/index.ts"],
            "@market-hunter/hh-worker": ["packages/hh-worker/src/index.ts"],
            "@market-hunter/hh-worker/job": ["packages/hh-worker/src/job/index.ts"],
            "@market-hunter/hh-worker/config": ["packages/hh-worker/src/config/index.ts"],
            "@market-hunter/hh-worker/lib": ["packages/hh-worker/src/lib/index.ts"],
            "@market-hunter/hh-worker/types": ["packages/hh-worker/src/types/index.ts"],
            "@repositories/*": ["src/repositories/*"]
        }
    },
    "include": ["src/**/*", "packages/hh-worker/src/**/*", "packages/contracts/src/**/*"],
    "exclude": ["node_modules", "dist"]
}
